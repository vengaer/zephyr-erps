menu "Ethernet Ring Protection Switching"

config ERPS
	bool "Ethernet ring protection switching"
	default y
	depends on DT_HAS_ITU_T_ERPS_NODE_ENABLED && NETWORKING
	select NET_VLAN
	select NET_L2_ETHERNET_MGMT
	help
	  Ethernet ring protection switching provides recovery switching
	  for Ethernet rings while ensuring there are no loops in the
	  network. Select y to enable this feature.

if ERPS

config ERPS_INIT_PRIORITY
	int "ERPS initialization priority"
	default 91
	help
	  ERPS link initialization priority.

config ERPS_SHELL
	bool "ERPS administration from the shell"
	select NET_SHELL
	select SHELL_HELP
	help
	  Set to gain access to the erps shell subcommands.

config ERPS_PAD_RAPS_PDUS
	bool "Pad R-APS PDUs"
	default y
	help
	  Standard R-APS frames are 55 octets, i.e. smaller than the minimum size 64 byte Ethernet
	  frame. Such small frames - so called runt frames - are automatically dropped by network
	  devices.

	  Enabling this option causes the ERPS implementation to automatically pad each PDU to 60
	  bytes, avoiding it being dropped by network devices once the 4 byte CRC has been appended.

	  Say n only if your MAC is configured to to pad runt frames.


module = ERPS
module-str = erps
source "subsys/logging/Kconfig.template.log_config"

endif

endmenu
